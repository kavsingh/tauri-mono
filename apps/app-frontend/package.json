		"@tauri-apps/plugin-log": "catalog:",
		"@tauri-apps/plugin-opener": "2.7.2",
		"@tauri-apps/plugin-store": "2.5.0",
		"@wdio/tauri-plugin": "catalog:",
		"neverthrow": "catalog:",
