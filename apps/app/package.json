{
	"name": "app",
	"version": "1.0.0-dev.0",
	"description": "a tauri app",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"tdd:ui": "vitest",
		"test": "pnpm test:tauri && pnpm test:ui",
		"test:ci": "pnpm test:ui --silent --coverage",
		"test:ui": "vitest run",
		"test:tauri": "cd src-tauri && cargo test",
		"lint": "pnpm lint:ui",
		"lint:ui": "cross-env tsr generate && oxlint && oxfmt --check",
		"lint:tauri": "cargo clippy --all-targets --all-features",
		"before:dev": "cross-env pnpm build:isolation && vite dev",
		"before:build": "cross-env pnpm build:isolation && rimraf ./dist && vite build",
		"dev": "tauri dev",
		"build:mac": "tauri build --target universal-apple-darwin",
		"build:win": "tauri build --target x86_64-pc-windows-msvc",
		"build:isolation": "cross-env rimraf ./dist-isolation && vite -c vite.isolation.config.ts build",
		"testscript": "pnpm scripts/testscript.ts"
	},
	"dependencies": {
		"@tanstack/solid-devtools": "0.8.13",
		"@tanstack/solid-query": "5.103.2",
		"@tanstack/solid-query-devtools": "5.103.2",
		"@tanstack/solid-router": "1.170.36",
		"@tanstack/solid-router-devtools": "1.167.2",
		"@tauri-apps/api": "2.11.1",
		"@tauri-apps/plugin-dialog": "2.7.3",
		"@tauri-apps/plugin-log": "2.9.2",
		"@tauri-apps/plugin-store": "2.4.5",
		"neverthrow": "catalog:",
		"solid-js": "1.9.15",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1"
	},
	"devDependencies": {
		"@solidjs/testing-library": "0.8.10",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/eslint-plugin-router": "1.162.0",
		"@tanstack/router-cli": "1.167.38",
		"@tanstack/router-plugin": "1.168.40",
		"@tauri-apps/cli": "2.11.5",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/user-event": "14.6.7",
		"@vitest/coverage-v8": "5.0.2",
		"caniuse-lite": "1.0.30001812",
		"eslint-plugin-better-tailwindcss": "4.7.0",
		"eslint-plugin-jest-dom": "5.10.1",
		"eslint-plugin-solid": "0.18.0",
		"eslint-plugin-testing-library": "7.16.2",
		"jsdom": "30.1.1",
		"oxlint-plugin-eslint": "catalog:",
		"tailwindcss": "4.3.3",
		"terser": "5.51.2",
		"tw-animate-css": "1.4.0",
		"vite": "8.3.1",
		"vite-plugin-checker": "0.14.5",
		"vite-plugin-solid": "2.11.14",
		"vitest": "5.0.2",
		"vitest-canvas-mock": "1.2.0"
	}
}
