{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main-remote",
	"description": "Capability for remote content in main window",
	"windows": ["main"],
	"local": true,
	"remote": { "urls": ["http://localhost:*"] },
	"permissions": [
		"allow-get-system-info",
		"allow-get-system-stats",
		"allow-get-theme-preference",
		"allow-set-theme-preference",
		"allow-open-user-dir",
		"allow-remote-ready",

		"core:event:allow-emit",
		"core:event:allow-emit-to",
		"core:event:allow-listen",
		"core:event:allow-unlisten",

		"core:window:allow-start-dragging",
		"core:window:allow-show",

		"dialog:allow-open",

		"log:allow-log",

		{
			"identifier": "opener:allow-open-url",
			"allow": [{ "url": "https://*.github.io" }, { "url": "native-access:*" }]
		}
	]
}
