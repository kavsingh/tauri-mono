{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"identifier": "com.app-remote.dev",
	"app": {
		"withGlobalTauri": true,
		"security": {
			"capabilities": ["main", "main-remote", "local", "loading", "webdriver"],
			"assetProtocol": { "enable": false, "scope": [] },
			"dangerousDisableAssetCspModification": false,
			"freezePrototype": true,
			"pattern": {
				"use": "isolation",
				"options": { "dir": "../dist-isolation" }
			},
			"csp": "default-src blob: data: filesystem: ws: wss: http: https: tauri: app-local: 'unsafe-eval' 'unsafe-inline' 'self'; img-src 'self' data: blob:"
		}
	}
}
