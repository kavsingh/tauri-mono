{
	"$schema": "https://json.schemastore.org/tsconfig",
	"include": ["src", "src-isolation"],
	"extends": "code-config/tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"lib": ["esnext", "dom", "dom.iterable", "dom.asynciterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"paths": { "~/*": ["./src/*"] },
		"sourceMap": true,
		"target": "esnext",
		"types": ["vite/client"]
	}
}
