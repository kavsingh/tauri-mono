{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"targetDefaults": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["{projectRoot}/dist/**"],
			"cache": true
		},
		"build:mac": {
			"dependsOn": ["^build"],
			"outputs": [
				"{projectRoot}/dist/**",
				"{workspaceRoot}/target/universal-apple-darwin/**"
			],
			"cache": true
		},
		"build:win": {
			"dependsOn": ["^build"],
			"outputs": ["{projectRoot}/dist/**"],
			"cache": true
		},
		"build:e2e:mac": {
			"dependsOn": ["^build"],
			"outputs": [
				"{projectRoot}/dist/**",
				"{workspaceRoot}/target/universal-apple-darwin/**"
			],
			"cache": true
		},
		"dev": {
			"cache": false
		},
		"test": {
			"cache": false
		},
		"test:ci": {
			"cache": false
		},
		"lint": {
			"cache": false
		}
	},
	"analytics": false
}
