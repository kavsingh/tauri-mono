{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"targetDefaults": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["{projectRoot}/dist/**"],
			"cache": true
		},
		"build:embedded": {
			"inputs": ["default", "^default"],
			"outputs": [
				"{projectRoot}/dist/**",
				"{workspaceRoot}/apps/app/fallback/ui/**"
			],
			"cache": true
		},
		"build:release": {
			"inputs": ["default", "^default"],
			"outputs": ["{projectRoot}/dist/**"],
			"cache": false
		},
		"build:mac": {
			"dependsOn": ["^build", "app-frontend:build:embedded"],
			"inputs": ["default", "^default", "env:FRONTEND_RELEASE_PUBLIC_KEY"],
			"outputs": [
				"{projectRoot}/dist/**",
				"{workspaceRoot}/apps/app/fallback/ui/**",
				"{workspaceRoot}/target/universal-apple-darwin/**"
			],
			"cache": true
		},
		"build:win": {
			"dependsOn": ["^build", "app-frontend:build:embedded"],
			"inputs": ["default", "^default", "env:FRONTEND_RELEASE_PUBLIC_KEY"],
			"outputs": [
				"{projectRoot}/dist/**",
				"{workspaceRoot}/apps/app/fallback/ui/**",
				"{workspaceRoot}/target/x86_64-pc-windows-msvc/**"
			],
			"cache": true
		},
		"build:e2e:mac": {
			"dependsOn": ["^build", "app-frontend:build:embedded"],
			"inputs": ["default", "^default"],
			"outputs": [
				"{projectRoot}/dist/**",
				"{workspaceRoot}/apps/app/fallback/ui/**",
				"{workspaceRoot}/target/universal-apple-darwin/**"
			],
			"cache": true
		},
		"build:e2e:win": {
			"dependsOn": ["^build", "app-frontend:build:embedded"],
			"inputs": ["default", "^default"],
			"outputs": [
				"{projectRoot}/dist/**",
				"{workspaceRoot}/apps/app/fallback/ui/**",
				"{workspaceRoot}/target/x86_64-pc-windows-msvc/**"
			],
			"cache": true
		},
		"dev": {
			"cache": false
		},
		"test": {
			"cache": false
		},
		"test:ci": {
			"cache": false
		},
		"lint": {
			"cache": false
		}
	},
	"analytics": false
}
